  @@unique([article_id, role], map: "knowledge_base_article_accesses_article_id_role_unique")
  @@unique([article_id, user_id], map: "knowledge_base_article_accesses_article_id_user_id_unique")
  @@ignore
}

model project_note_images {
  id              String        @id @db.Uuid
  company_id      String        @db.Uuid
  project_note_id String        @db.Uuid
  disk            String        @default("project_note_images") @db.VarChar(64)
  path            String        @db.VarChar(1024)
  original_name   String        @db.VarChar(255)
  mime_type       String?       @db.VarChar(255)
  size            BigInt        @default(0)
  uploaded_by     String?       @db.Uuid
  created_at      DateTime?     @db.Timestamp(0)
  updated_at      DateTime?     @db.Timestamp(0)
  companies       Company       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_note_images_company_id_foreign")
  project_notes   project_notes @relation(fields: [project_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_note_images_project_note_id_foreign")
  users           User?         @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "project_note_images_uploaded_by_foreign")

  @@index([project_note_id, created_at], map: "project_note_images_note_created_idx")
  @@ignore
}

model task_attachments {
  id            String    @id @db.Uuid
  company_id    String    @db.Uuid
  task_id       String    @db.Uuid
  path          String    @db.VarChar(1024)
  original_name String    @db.VarChar(255)
  mime_type     String?   @db.VarChar(255)
  size          BigInt    @default(0)
  uploaded_by   String?   @db.Uuid
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  companies     Company   @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_attachments_company_id_foreign")
  tasks         Task      @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_attachments_task_id_foreign")
  users         User?     @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "task_attachments_uploaded_by_foreign")

  @@index([task_id, created_at], map: "task_attachments_task_created_idx")
